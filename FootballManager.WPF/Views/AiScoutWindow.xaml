<!--
מטרה: מציג בחירת שחקן וניתוח בסקאוט WPF.
מי משתמש: MainWindow פותח את החלון, AiScoutViewModel מספק נתונים.
פעולות: טעינת שחקנים ולחצן ניתוח.
תלויות: Binding אל AiScoutViewModel.
-->
<Window x:Class="FootballManager.WPF.Views.AiScoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="סקאוט AI — FootballManager"
        Height="620"
        Width="820"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#0B1421"
        Foreground="#F3F6FA"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="סקאוט AI" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="ניתוח מקצועי לפי נתוני השחקן שבמסד FootballManager" Foreground="#91A2B7" Margin="0,5,0,0" />
            <TextBlock Text="השימוש מותר ל־Player. גם בקשה מתפקיד אחר נבדקת ונחסמת בשרת." Foreground="#91A2B7" Margin="0,5,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="בחירת שחקן" Foreground="#C5D0DE" Margin="0,0,0,6" />
        <!-- הבחירה קובעת את מזהה השחקן שהסקאוט שולח לשרת. -->
        <ComboBox x:Name="PlayersComboBox" Grid.Row="2" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer, UpdateSourceTrigger=PropertyChanged}"
                  Background="#152438" Foreground="#F3F6FA" BorderBrush="#30445C" Padding="10,8" Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="#F3F6FA">
                        <Run Text="{Binding FirstName}" />
                        <Run Text=" " />
                        <Run Text="{Binding LastName}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Position}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Row="3" Background="#152438" BorderBrush="#30445C" BorderThickness="1" CornerRadius="10" Padding="16">
            <!-- תוצאת הניתוח יכולה להתפרס על כמה שורות ולכן מוצגת עם גלילה. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding AnalysisText}" TextWrapping="Wrap" FontSize="15" LineHeight="25" />
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="True">
            <Button x:Name="AnalyzeButton" DockPanel.Dock="Left" Content="נתח שחקן" Padding="22,10" Margin="0,0,0,0"
                    Background="#E7BD20" Foreground="#152030" BorderThickness="0" FontWeight="SemiBold"
                    Click="Analyze_Click" />
            <TextBlock Text="{Binding StatusText}" Foreground="#C5D0DE" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" />
        </DockPanel>
    </Grid>
</Window>
