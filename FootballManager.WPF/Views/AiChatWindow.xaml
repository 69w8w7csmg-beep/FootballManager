<!--
תפקיד הקובץ: מגדיר את תצוגת הצ'אט ואת כפתורי השליחה והאיפוס.
שכבה: תצוגה בלקוח WPF.
משתמשים: משתמשים בתפקיד שחקן.
קשר בפרויקט: מציג את השיחה ואת ההודעה שחזרה מהשרת.
-->
<Window x:Class="FootballManager.WPF.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="צ'אט בינה — FootballManager" Width="760" Height="620" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0B1421" Foreground="#F3F6FA"
        FontFamily="Segoe UI" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="צ'אט FootballManager" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="שאל על שחקנים ובקש להוסיף שחקן יחיד למועדפים. השיחה נשמרת בשרת בזמן ההפעלה."
                       Foreground="#AFC2D4" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#152438" CornerRadius="8" Padding="14">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranscriptText" Text="אפשר לשאול שאלה כדי להתחיל." TextWrapping="Wrap"
                           FontSize="15" LineHeight="24"/>
            </ScrollViewer>
        </Border>
        <TextBox x:Name="QuestionBox" Grid.Row="2" Height="75" Margin="0,12,0,8"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 Background="#152438" Foreground="#F3F6FA" BorderBrush="#30445C" Padding="10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="SendButton" Content="שלח שאלה" Click="Send_Click" Padding="22,9"
                    Background="#E7BD20" Foreground="#152030" FontWeight="SemiBold" BorderThickness="0"/>
            <Button x:Name="ResetButton" Content="אפס שיחה" Click="Reset_Click" Padding="22,9" Margin="10,0,0,0"
                    Background="#30445C" Foreground="#F3F6FA" BorderThickness="0"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
